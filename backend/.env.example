# Copy to backend/.env and fill in from Supabase Dashboard -> Project Settings -> API
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Supabase Dashboard -> Connect -> Shared pooler (percent-encode special characters in the password)
# Only used by scripts/init_db.py to create tables — the API itself does not need it.
DATABASE_URL=postgresql://postgres.your-project-ref:your-password@aws-0-region.pooler.supabase.com:5432/postgres

# Comma-separated list of frontend origins allowed to call the API
CORS_ORIGINS=http://localhost:3000

# --- Auth ---
# Long random string, e.g. python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=change-me
JWT_EXPIRE_MINUTES=480
# Where the Next.js app runs. Supabase invitation emails link to {FRONTEND_URL}/invite,
# so add that URL to Supabase Dashboard -> Authentication -> URL Configuration -> Redirect URLs.
FRONTEND_URL=http://localhost:3000
